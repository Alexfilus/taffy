<test name="grid_overflow_auto_margins_alignment__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="ltr" position="absolute" width="300px" grid-template-columns="300px">
      <div direction="ltr" position="relative" justify-self="center" width="600px" height="20px" margin-left="auto" margin-right="auto"/>
      <div direction="ltr" position="relative" justify-self="end" width="600px" height="20px" margin-left="auto"/>
      <div direction="ltr" position="relative" justify-self="center" width="600px" height="20px" margin-right="auto"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="60" resolved-rows="20px 20px 20px" resolved-columns="300px">
      <node x="0" y="0" width="600" height="20"/>
      <node x="0" y="20" width="600" height="20"/>
      <node x="0" y="40" width="600" height="20"/>
    </node>
  </expectations>
</test>
