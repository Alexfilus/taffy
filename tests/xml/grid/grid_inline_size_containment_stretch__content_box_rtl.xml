<test name="grid_inline_size_containment_stretch__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="rtl" position="absolute" width="150px" grid-template-columns="auto 100px">
      <div display="block" box-sizing="content-box" direction="rtl" position="relative" intrinsic-size-containment="width">
        <div box-sizing="content-box" direction="rtl" position="relative" width="240px" height="20px"/>
      </div>
      <div box-sizing="content-box" direction="rtl" position="relative" height="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="150" height="20" resolved-rows="20px" resolved-columns="50px 100px">
      <node x="100" y="0" width="50" height="20">
        <node x="-190" y="0" width="240" height="20"/>
      </node>
      <node x="0" y="0" width="100" height="20"/>
    </node>
  </expectations>
</test>
